# Source files (we publish built files in dist/)
src/
tests/
scripts/

# Development files
.github/
.vscode/
.idea/

# Test files and coverage
*.test.ts
*.spec.ts
coverage/
.nyc_output/
tests/

# Development configs
tsconfig.json
tsup.config.ts
vitest.config.ts
.eslintrc*
.prettierrc*

# Documentation (except README, LICENSE, SPEC)
docs/PHASE*.md
docs/TESTING.md
docs/CONFIGURATION.md

# Build artifacts
*.tsbuildinfo
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Misc
.temp
tmp/
temp/

# Git
.git/
.gitignore
.gitattributes

# CI/CD (included in source, not needed in package)
.github/

# Lock files (let users manage their own)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Example and test fixtures
example.ts
fixtures/
